# Copy to `.env` or `.env.local` (not committed) and fill in values:
#   cp .env.example .env
#
# During `npm run dev`, API calls use the Vite proxy: /api → http://localhost:8000
# (see vite.config.js). Set VITE_API_URL for production / hosted API origin.

# Production / hosted API origin (Vercel builds): when set, the app calls `${VITE_API_URL}/api/...`
# Example: https://your-backend.up.railway.app
VITE_API_URL=http://127.0.0.1:8000

# Backend origin for links (e.g. Django Admin from Admin dashboard)
VITE_DJANGO_ORIGIN=http://127.0.0.1:8000

# Optional. Canonical site origin (no trailing slash) so production builds emit
# absolute og:image, og:url, and canonical URLs.
# VITE_SITE_URL=https://loya-legal-os.vercel.app

# Optional. Override in-app walkthrough videos (defaults: /walkthrough-1.mp4, /walkthrough-2.mp4)
# VITE_WALKTHROUGH_VIDEO_1_URL=/your-first-video.mp4
# VITE_WALKTHROUGH_VIDEO_2_URL=/your-second-video.webm
